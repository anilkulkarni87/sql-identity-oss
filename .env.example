# Image pinning (used by docker-compose.prod.yml)
IDR_IMAGE_REGISTRY=ghcr.io/anilkulkarni87/sql-identity-resolution
IDR_IMAGE_TAG=0.5.1

# Ports
IDR_API_PORT=8000
IDR_UI_PORT=3000

# API runtime
IDR_DATABASE=/data/idr.duckdb
IDR_CORS_ORIGINS=http://localhost:3000
IDR_ALLOW_INSECURE_DEV_AUTH=false
IDR_CONNECTION_IDLE_TTL_SECONDS=3600
# Optional: dotted class path for enterprise session store backend
IDR_SESSION_STORE_CLASS=
IDR_REDIS_URL=
IDR_REDIS_NAMESPACE=idr:session_store
IDR_PIP_EXTRAS=api,duckdb,enterprise
IDR_RUN_JOB_DB_PATH=/tmp/idr_run_jobs.sqlite3
IDR_RUN_JOB_MAX_ATTEMPTS=3
IDR_RUN_JOB_RETRY_BACKOFF_SECONDS=1.0
IDR_RUN_JOB_WEBHOOK_URL=
# Preferred: mount file and set IDR_RUN_JOB_WEBHOOK_BEARER_TOKEN_FILE
IDR_RUN_JOB_WEBHOOK_BEARER_TOKEN_FILE=
IDR_RUN_JOB_WEBHOOK_BEARER_TOKEN=
IDR_RUN_JOB_WEBHOOK_TIMEOUT_SECONDS=3.0

# UI runtime
VITE_API_BASE_URL=/api
VITE_ALLOW_INSECURE_DEV_AUTH=false

# Optional enterprise auth settings
IDR_AUTH_ISSUER=
IDR_AUTH_AUDIENCE=account
IDR_AUTH_JWKS_URL=
IDR_AUTH_JWKS_TTL_SECONDS=300
IDR_AUTH_JWKS_HTTP_TIMEOUT_SECONDS=5
# Optional role->permission mapping override (JSON object)
IDR_AUTHZ_ROLE_PERMISSIONS_JSON=
IDR_SERVICE_AUTH_DB_PATH=/tmp/idr_service_auth.sqlite3
IDR_AUDIT_DB_PATH=/tmp/idr_audit.sqlite3
# Enterprise admin credentials (required by enterprise compose profiles)
IDR_KEYCLOAK_ADMIN_PASSWORD=
IDR_GRAFANA_ADMIN_PASSWORD=
